CREATE TABLE WalletTransactionEntity (
    id TEXT NOT NULL PRIMARY KEY,
    title TEXT NOT NULL,
    date TEXT NOT NULL,
    amount INTEGER NOT NULL,
    isIncome INTEGER NOT NULL DEFAULT 1,
    timestamp INTEGER NOT NULL
);

selectAllTransactions:
SELECT * FROM WalletTransactionEntity;

getBalance:
SELECT SUM(amount) AS SUM FROM WalletTransactionEntity;

insertOrReplaceTransaction:
INSERT OR REPLACE INTO WalletTransactionEntity(id, title, date, amount, isIncome, timestamp)
VALUES ?;